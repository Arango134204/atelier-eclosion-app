# Copiar a `.env` y completar. No subir `.env` al repositorio.
# Las variables EXPO_PUBLIC_* se empaquetan en el cliente: no son secretos.

# API pública de la tienda Shopify del cliente (sin credenciales)
EXPO_PUBLIC_SHOPIFY_BASE_URL=https://ateliereclosionbijoux.com

# Firebase (consola: https://console.firebase.google.com → Proyecto → Configuración → Tus apps → Web)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
